# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/nestjs_ecommerce

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080
ENABLE_SWAGGER=true
FALLBACK_LANGUAGE=en

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_ACCESS_SECRET_TOKEN=your_access_token_secret_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET_TOKEN=your_refresh_token_secret_key_here_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFICATION_SECRET_TOKEN=your_verification_token_secret_key_here_change_in_production

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# ============================================
# EMAIL / SMTP CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM_NAME=E-Commerce API

# ============================================
# GOOGLE MAPS API
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json

# ============================================
# AWS S3 — Object Storage
# ============================================

# AWS credentials — create a dedicated IAM user with S3-only permissions
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS region where your bucket lives (e.g. ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# S3 bucket name — must already exist in your AWS account
AWS_S3_BUCKET_NAME=your-bucket-name


# ============================================
# HTTP REQUEST LOGGING (MORGAN)
# ============================================
# Enable/disable HTTP request logging (default: true)
ENABLE_HTTP_LOGGING=true

# HTTP log format options:
# - 'auto' (default): Automatically chooses format based on NODE_ENV
# - 'dev': Colored output for development
# - 'combined': Standard Apache combined log format
# - 'short': Shorter than combined, includes response time
# - 'tiny': Minimal output
# - 'custom': Uses custom format defined in morgan.config.ts
HTTP_LOG_FORMAT=auto

# In production, only log errors (status >= 400) to reduce noise (default: false)
LOG_ERRORS_ONLY=false

# Enable security-focused logging for authentication routes and errors (default: true)
ENABLE_SECURITY_LOGGING=true

# Optional: Path to log file (if you want to write logs to file instead of console)
# HTTP_LOG_FILE_PATH=./logs/http.log
