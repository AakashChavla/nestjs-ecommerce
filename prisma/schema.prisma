// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USERS TABLE
// ============================================
model User {
  id                String  @id @default(uuid()) @db.Uuid
  email             String  @unique @db.VarChar(255)
  passwordHash      String  @map("password_hash") @db.VarChar(255)
  mobileCountryCode String? @map("mobile_country_code") @db.VarChar(10)
  mobile            String? @unique @db.VarChar(20)

  name String? @db.VarChar(100)

  role     UserRole @default(USER)
  isActive Boolean  @default(true) @map("is_active")

  emailVerified    Boolean   @default(false) @map("email_verified")
  isMobileVerified Boolean   @default(false) @map("is_mobile_verified")
  lastLoginAt      DateTime? @map("last_login_at")

  tokenVersion Int @default(0) @map("token_version")

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  SELLER
}

// ============================================
// ADDRESS ENUMS
// ============================================

// AddressType describes the *purpose* of an address from the
// owner's perspective (how they use it). Infrastructure locations
// (warehouse, hub, etc.) are already expressed by AddressOwnerType
// and must NOT be duplicated here — that would couple two separate
// concerns and allow nonsensical combinations like a USER owning
// a WAREHOUSE address type.
enum AddressType {
  HOME
  OFFICE
  BILLING
  SHIPPING
  OTHER
}

// AddressOwnerType describes *which kind of entity* owns the address.
// This is the single source of truth for infrastructure classifications.
enum AddressOwnerType {
  USER
  SELLER
  WAREHOUSE
  HUB
  PICKUP_POINT
  RETURN_CENTER
}

// ============================================
// ADDRESS TABLE
// ============================================
// Design decisions:
//
// [3NF] Only cityId is stored. stateId and countryId are transitively
//   determined by cityId (city → state → country), so storing them
//   directly would violate 3NF and risk inconsistent data.
//   Reach them via: address.city.state / address.city.state.country
//
// [isDefault] At most one default per (ownerId, ownerType) pair.
//   Enforced by a partial unique index in the migration SQL:
//     WHERE is_default = true AND deleted_at IS NULL
//   Prisma @@unique does not support WHERE clauses so this cannot
//   be expressed in the schema — it lives only in the migration.
//
// [isActive removed] deletedAt (soft delete) already covers the
//   "inactive" case. Two fields for the same concept must be kept
//   in sync with no benefit. Convention: active = deleted_at IS NULL.
//
// [latitude/longitude] Kept for pin-drop delivery precision (user
//   marks their exact gate on a map). Not derivable from cityId.
// ============================================
model Address {
  id String @id @default(uuid()) @db.Uuid

  // Polymorphic owner — no DB-level FK is possible across multiple tables.
  // Application layer must handle orphan cleanup on owner deletion.
  ownerType AddressOwnerType @map("owner_type")
  ownerId   String           @map("owner_id") @db.Uuid

  addressType AddressType @default(HOME) @map("address_type")

  // At most one true per (ownerId, ownerType) — see migration for partial unique index.
  isDefault Boolean @default(false) @map("is_default")

  label String? @db.VarChar(50) // user-defined nickname e.g. "Mom's place"

  addressLine1 String  @map("address_line1") @db.VarChar(255)
  addressLine2 String? @map("address_line2") @db.VarChar(255)
  landmark     String? @db.VarChar(255)
  pincode      String  @db.VarChar(20)

  // Only cityId FK — state & country resolved via City relation.
  cityId String @map("city_id") @db.Uuid
  city   City   @relation(fields: [cityId], references: [id])

  // Optional pin-drop coordinates set by user on a map.
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  // Delivery contact — may differ from the account holder.
  contactName  String? @map("contact_name") @db.VarChar(100)
  contactPhone String? @map("contact_phone") @db.VarChar(20)

  // Soft delete only. Active = deleted_at IS NULL.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([ownerId, ownerType])
  @@index([ownerId, ownerType, isDefault])
  @@index([ownerType])
  @@index([addressType])
  @@index([pincode])
  @@index([cityId])
  @@map("addresses")
}

// ============================================
// COUNTRY TABLE
// ============================================
model Country {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  countryCode String   @unique @map("country_code") @db.VarChar(10)
  flag        String?  @db.VarChar(10)
  phoneCode   String?  @map("phone_code") @db.VarChar(20)
  currency    String?  @db.VarChar(10)
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  isActive    Boolean  @default(true) @map("is_active")

  states State[]
  cities City[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([name])
  @@index([countryCode])
  @@index([isActive])
  @@map("countries")
}

// ============================================
// STATE TABLE
// ============================================
model State {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  stateCode String   @map("state_code") @db.VarChar(20)
  countryId String   @map("country_id") @db.Uuid
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  isActive  Boolean  @default(true) @map("is_active")

  country Country @relation(fields: [countryId], references: [id])
  cities  City[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([stateCode, countryId])
  @@index([name])
  @@index([stateCode])
  @@index([countryId])
  @@index([isActive])
  @@map("states")
}

// ============================================
// CITY TABLE
// ============================================
// countryId is intentionally denormalized here (documented 3NF exception)
// so that filtering cities by country is a single-table scan without a join.
// Safe because a city's country is immutable after seeding.
// ============================================
model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  cityCode  String   @map("city_code") @db.VarChar(20)
  stateId   String   @map("state_id") @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  isActive  Boolean  @default(true) @map("is_active")

  state     State     @relation(fields: [stateId], references: [id])
  country   Country   @relation(fields: [countryId], references: [id])
  addresses Address[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([name])
  @@index([cityCode])
  @@index([stateId])
  @@index([countryId])
  @@index([isActive])
  @@index([stateId, countryId])
  @@map("cities")
}

// ============================================
// ENUMS
// ============================================

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ============================================
// CATEGORIES TABLE
// Self-referential — supports infinite nesting
// (Electronics > Mobiles > Smartphones)
// ============================================
model Category {
  id       String  @id @default(uuid()) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid

  name     String  @db.VarChar(100)
  slug     String  @unique @db.VarChar(120)
  iconUrl  String? @map("icon_url") @db.VarChar(500)
  isActive Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

// ============================================
// PRODUCTS TABLE
// Core listing — price/inventory lives in
// variants; use variant with no options for
// simple (single-variant) products.
// ============================================
model Product {
  id         String @id @default(uuid()) @db.Uuid
  sellerId   String @map("seller_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  name        String @db.VarChar(300)
  slug        String @unique @db.VarChar(350)
  description String @db.Text
  brand       String @db.VarChar(150)

  // Pricing — mrp = max retail price, sellingPrice = what customer pays
  mrp             Decimal @db.Decimal(12, 2)
  sellingPrice    Decimal @map("selling_price") @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  currency        String  @default("INR") @db.VarChar(10)

  status     ProductStatus @default(DRAFT)
  isActive   Boolean       @default(true) @map("is_active")
  isFeatured Boolean       @default(false) @map("is_featured")

  // Denormalised counters — updated via triggers or background job
  // Never write these directly; go through the event that causes the change
  avgRating   Float @default(0) @map("avg_rating") @db.DoublePrecision
  reviewCount Int   @default(0) @map("review_count")
  viewCount   Int   @default(0) @map("view_count")

  seller     User               @relation(fields: [sellerId], references: [id])
  category   Category           @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  attributes ProductAttribute[]
  tags       ProductTag[]
  // reviews    ProductReview[]
  // views      ProductView[]
  // wishlists  Wishlist[]
  // searchMeta ProductSearchMeta?

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([isActive])
  @@index([isFeatured])
  @@index([brand])
  @@index([sellingPrice])
  @@index([avgRating])
  @@index([createdAt])
  @@map("products")
}

// ============================================
// PRODUCT IMAGES TABLE
// s3_key only — never store full URLs in DB
// ============================================
model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  s3Key     String  @map("s3_key") @db.VarChar(500)
  altText   String? @map("alt_text") @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([productId, isPrimary])
  @@map("product_images")
}

// ============================================
// PRODUCT VARIANTS TABLE
// One row per SKU (Color/Size/Storage etc.)
// Simple products have exactly one variant.
// // ============================================
model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  sku           String   @unique @db.VarChar(100)
  name          String   @db.VarChar(200) // e.g. "128GB / Midnight Black"
  priceOverride Decimal? @map("price_override") @db.Decimal(12, 2) // null = use product.sellingPrice
  isActive      Boolean  @default(true) @map("is_active")

  product    Product                   @relation(fields: [productId], references: [id])
  attributes ProductVariantAttribute[]
  inventory  Inventory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@map("product_variants")
}

// ============================================
// ATTRIBUTES TABLE
// Master list: Color, Size, Storage, RAM …
// is_variant_axis = true → used to form SKU combos (Color, Size)
// is_filterable = true  → shown in filter sidebar
// ============================================
model Attribute {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @db.VarChar(100) // "color"
  displayName String @map("display_name") @db.VarChar(100) // "Color"

  isFilterable  Boolean @default(false) @map("is_filterable")
  isVariantAxis Boolean @default(false) @map("is_variant_axis")

  productAttributes ProductAttribute[]
  variantAttributes ProductVariantAttribute[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([isFilterable])
  @@index([isVariantAxis])
  @@map("attributes")
}

// Product-level attributes (Material, Warranty, Pattern …)
model ProductAttribute {
  id          String @id @default(uuid()) @db.Uuid
  productId   String @map("product_id") @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String @db.VarChar(255)

  product   Product   @relation(fields: [productId], references: [id])
  attribute Attribute @relation(fields: [attributeId], references: [id])

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
  @@map("product_attributes")
}

// Variant-level attributes (Color = Red, Size = XL …)
model ProductVariantAttribute {
  id          String @id @default(uuid()) @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  value       String @db.VarChar(255)

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  attribute Attribute      @relation(fields: [attributeId], references: [id])

  @@unique([variantId, attributeId])
  @@index([variantId])
  @@index([attributeId])
  @@map("product_variant_attributes")
}

// ============================================
// TAGS TABLE (many-to-many via ProductTag)
// Flexible labels: "trending", "sale", "new"
// ============================================
model Tag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(80)
  slug String @unique @db.VarChar(90)

  productTags ProductTag[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([slug])
  @@map("tags")
}

model ProductTag {
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id])
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// ============================================
// INVENTORY TABLE
// Per variant + per warehouse.
// reserved_qty = qty locked by open orders.
// available = quantity - reserved_qty
// ============================================
model Inventory {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  quantity         Int    @default(0)
  reservedQty      Int    @default(0) @map("reserved_qty")
  reorderThreshold Int    @default(5) @map("reorder_threshold")
  warehouseCode    String @default("DEFAULT") @map("warehouse_code") @db.VarChar(50)

  variant ProductVariant @relation(fields: [variantId], references: [id])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([variantId, warehouseCode])
  @@index([variantId])
  @@index([warehouseCode])
  @@map("inventory")
}

